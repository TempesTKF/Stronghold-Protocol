<?xml version="1.0" encoding="utf-8"?>
<!--
  首页（MainActivity.showSetup）：离线版三块——本地离线、联机、素材与皮肤；联机版只有联机一块。
  首次启动的离线版先停在这里让玩家选；之后每次启动直接进上次的模式，返回键「切换模式 / 服务器」回到这里。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1113"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_home_title"
            android:textColor="#F2F5F4"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#E8C46A"
            android:textSize="13sp" />

        <!-- 本地离线（只有离线版显示） -->
        <LinearLayout
            android:id="@+id/setup_local_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_local_title"
                android:textColor="#7BD9A5"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/setup_local_hint"
                android:textColor="#9FB0AA"
                android:textSize="13sp" />

            <Button
                android:id="@+id/setup_local"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minWidth="180dp"
                android:text="@string/setup_local" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:background="#243029" />
        </LinearLayout>

        <!-- 联机：连服务器，和网页端玩家进同一批房间 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/setup_title"
            android:textColor="#7BD9A5"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/setup_desc"
            android:textColor="#9FB0AA"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/setup_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/setup_hint"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="#F2F5F4"
            android:textColorHint="#5A6763"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setup_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="140dp"
                android:text="@string/setup_connect" />
        </LinearLayout>

        <!-- 素材与皮肤（只有离线版显示）：素材包、皮肤包单独导入，不在 APK 里 -->
        <LinearLayout
            android:id="@+id/setup_content_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#243029" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/content_title"
                android:textColor="#7BD9A5"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/content_desc"
                android:textColor="#9FB0AA"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/setup_content_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="#C7D3CE"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/setup_import"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="180dp"
                    android:text="@string/content_import" />

                <Button
                    android:id="@+id/setup_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:minWidth="140dp"
                    android:text="@string/content_clear" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/remote_note"
            android:textColor="#5A6763"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
